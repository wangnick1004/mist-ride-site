# 複製成 .env.local（本機）或設定在部署平台的環境變數。不要把真正的值提交到 git。

# 登入 cookie 的簽章金鑰，至少 32 字元：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 後台密碼雜湊：npm run admin:hash
ADMIN_PASSWORD_HASH=

# 正式環境的 PostgreSQL（Neon、Supabase、Zeabur 等）。本機不設定時自動使用 PGlite（website/.data/pglite）
# 網站啟動時會自動建立資料表，不必另外執行 migration
DATABASE_URL=

# 資料庫走平台內部網路、沒有 TLS 時（例如 Zeabur 內建 PostgreSQL）設為 disable；外部資料庫請保持空白（強制驗證憑證）
DATABASE_SSL=

# 部署在會覆寫 X-Forwarded-For 的平台（例如 Vercel）時設為 1，限流才會依使用者 IP 計算
TRUST_PROXY=

# 每日刪除過期資料的排程密鑰（至少 16 字元），排程以 Authorization: Bearer <值> 呼叫 /api/cron/purge
CRON_SECRET=

# 官方 LINE 帳號 ID（包含 @，例如 @shunlu）。設定後重新部署，網站上的 LINE 按鈕、優惠券、小幫手會自動啟用
NEXT_PUBLIC_LINE_OA_ID=@789dpnrq
