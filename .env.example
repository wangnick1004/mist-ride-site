# 複製成 .env.local（本機）或設定在部署平台的環境變數。不要把真正的值提交到 git。

# 登入 cookie 的簽章金鑰，至少 32 字元：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 後台密碼雜湊：npm run admin:hash
ADMIN_PASSWORD_HASH=

# 正式環境的 PostgreSQL（Neon、Supabase 等）。本機不設定時自動使用 PGlite（website/.data/pglite）
DATABASE_URL=

# 部署在會覆寫 X-Forwarded-For 的平台（例如 Vercel）時設為 1，限流才會依使用者 IP 計算
TRUST_PROXY=

# 每日刪除過期資料的排程密鑰（至少 16 字元），排程以 Authorization: Bearer <值> 呼叫 /api/cron/purge
CRON_SECRET=
